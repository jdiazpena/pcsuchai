{
  "schema_version": 1,
  "name": "stability",
  "description": "Twenty consecutive full-data rounds with no cooldown to expose thermal and memory drift.",
  "python_version": "3.13.5",
  "official": true,
  "orbit_backends": ["astropy", "skyfield"],
  "magnetic_backends": ["aacgmv2", "apexpy"],
  "repeats": 20,
  "warmups": 1,
  "limit": null,
  "plot_config": "configs/plots/archive-full.json",
  "cooldown_seconds": 0,
  "cooldown_until_c": null,
  "cooldown_max_seconds": 0,
  "collect_perf": false,
  "telemetry_interval_seconds": 2.0,
  "minimum_free_gb": 1.0,
  "maximum_temperature_c": 80.0,
  "continue_on_error": true,
  "max_consecutive_failures": 3,
  "timeout_seconds": 7200
}
